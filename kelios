    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$STATE/secrets/auth/main.private.pem" 2>/dev/null
    openssl pkey -in "$STATE/secrets/auth/main.private.pem" -pubout -out "$STATE/secrets/auth/main.public.pem" 2>/dev/null
    openssl rand -base64 32 > "$STATE/secrets/auth/main.aes"
  fi
