  source_release
  [ "$RELEASE" = "$SAVED_RELEASE" ] || fail 'Resume the prepared install from its recorded source release.'
  files; crypto; compose_env; owned
  build_images
  if [ "$MODE" = managed ]; then postgres_image; fi
  start_runtime; recovery; start_runtime
  printf 'KELIOS installation ready: https://%s:%s\n' "$BROWSER_HOST" "$HTTPS_PORT"
}
update() {
  [ "$PHASE" = initialized ] || fail 'Update requires an initialized installation. Resume a prepared install first.'
