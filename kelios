  [ -z "${C_BROWSER_HOST-}" ] || BROWSER_HOST=$C_BROWSER_HOST
  validate
  port_free "$HTTP_PORT"; port_free "$HTTPS_PORT"
  if [ "$BROWSER_HOST" != "$ORIGINAL_HOST" ]; then
    if [ -n "${C_TLS_CERTIFICATE-}${C_TLS_PRIVATE_KEY-}" ]; then
      [ -n "${C_TLS_CERTIFICATE-}" ] && [ -n "${C_TLS_PRIVATE_KEY-}" ] || fail 'Provide both TLS PEM paths when remapping a hostname.'
      certificate_store "$C_TLS_CERTIFICATE" "$C_TLS_PRIVATE_KEY"
    else certificate_generate; fi
  elif [ -n "${C_TLS_CERTIFICATE-}${C_TLS_PRIVATE_KEY-}" ]; then
    [ -n "${C_TLS_CERTIFICATE-}" ] && [ -n "${C_TLS_PRIVATE_KEY-}" ] || fail 'Provide both TLS PEM paths.'
    certificate_store "$C_TLS_CERTIFICATE" "$C_TLS_PRIVATE_KEY"
  fi
  [ "$BROWSER_HOST" = "$ORIGINAL_HOST" ] && [ "$HTTPS_PORT" = "$ORIGINAL_HTTPS" ] || ISSUER=https://$BROWSER_HOST:$HTTPS_PORT
  PHASE=restoring
  mkdir -p "$STATE/branding/logos" "$STATE/diagnostics"
  save; branding; files; crypto; compose_env
