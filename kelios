}
certificate_store() {
  [ -d "$STATE/secrets/tls" ] || mkdir -p "$STATE/secrets/tls"
  chmod 755 "$STATE/secrets/tls"
  STAGED_CERT=$(mktemp -d "$STATE/secrets/tls/.pending.XXXXXXXX") || fail 'Cannot stage certificate.'
  cp "$1" "$STAGED_CERT/certificate.pem"; cp "$2" "$STAGED_CERT/private.pem"
  chmod 755 "$STAGED_CERT"; chmod 444 "$STAGED_CERT/certificate.pem" "$STAGED_CERT/private.pem"
  tls "$STAGED_CERT/certificate.pem" "$STAGED_CERT/private.pem"
  new_version=$(openssl rand -hex 6)
  [ ! -e "$STATE/secrets/tls/$new_version" ] || fail 'Certificate version collision; retry.'
  mv "$STAGED_CERT" "$STATE/secrets/tls/$new_version"; STAGED_CERT=
  pointer=$(mktemp "$STATE/certificate.XXXXXXXX") || fail 'Cannot stage certificate pointer.'
  printf 'HOST=%s\nVERSION=%s\n' "$BROWSER_HOST" "$new_version" > "$pointer"
  chmod 600 "$pointer"; mv -f "$pointer" "$STATE/certificate.conf"
  CERT_DIR=$STATE/secrets/tls/$new_version
}
certificate_generate() {
  workspace
  case "$BROWSER_HOST" in *[!0-9.]*) san=DNS:$BROWSER_HOST;; *) bind "$BROWSER_HOST"; san=IP:$BROWSER_HOST;; esac
  [ "$BROWSER_HOST" != localhost ] || san=$san,IP:127.0.0.1
  openssl req -x509 -newkey rsa:3072 -nodes -keyout "$WORK/private.pem" -out "$WORK/certificate.pem" -days 730 -subj "/CN=$BROWSER_HOST" -addext "subjectAltName=$san" >/dev/null 2>&1 || fail 'Private certificate generation failed; check OpenSSL support.'
  certificate_store "$WORK/certificate.pem" "$WORK/private.pem"
