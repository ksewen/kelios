  [ -z "$BACKUP_OUTPUT" ] || fail 'restore does not accept --output.'
  for field in ${CONFIG_KEYS-}; do case "$field" in BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|TLS_CERTIFICATE|TLS_PRIVATE_KEY) ;; *) fail "Unsupported restore configuration field: $field";; esac; done
