    [ -z "$(find "$STATE" -type f ! -path "$STATE/certificate.conf" ! -path "$CERT_DIR/certificate.pem" ! -path "$CERT_DIR/private.pem" -print -quit)" ] || fail 'Pre-provisioned state contains unexpected files; refused installation.'
