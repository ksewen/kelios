  case "$1" in *.svg) extension=svg;; *.png) extension=png;; *.jpg|*.jpeg) extension=jpg;; *.webp) extension=webp;; *) fail 'Logo must be SVG, PNG, JPG or WebP.';; esac
  if [ "$2" = organization ]; then ORG_LOGO=organization.$extension; filename=$ORG_LOGO; else LOGO=logo.$extension; filename=$LOGO; fi
