}
recovery() {
  prompt 'GLOBAL ADMIN Email' ''; RECOVERY_EMAIL=$ANSWER
  case "$RECOVERY_EMAIL" in *[![:space:]]*) ;; *) fail 'GLOBAL ADMIN Email is required.';; esac
