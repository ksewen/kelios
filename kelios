  printf 'Managed recovery restored. Run ./kelios start; update OIDC callback registrations if the public origin changed.\n'
}
files_restore() {
  certificate_load
  [ "$CERT_HOST" = "$BROWSER_HOST" ] || fail 'Bundle certificate identity differs from saved browser host.'
  for f in secrets/db-password secrets/auth/main.private.pem secrets/auth/main.public.pem secrets/auth/main.aes; do [ -f "$STATE/$f" ] || fail 'Bundle is missing a required secret.'; done
}
discard_incomplete() {
  [ "$PHASE" = restoring ] || fail 'Only an incomplete restore can be discarded; initialized deployments are protected.'
  [ "$MODE" = managed ] || fail 'Only a managed incomplete restore can be discarded.'
  [ "$NONINTERACTIVE" = 0 ] || fail 'Discarding an incomplete restore requires an interactive terminal.'
  terminal; compose_env; owned
  printf 'This deletes only incomplete recovery state and its owned managed database. The backup bundle is untouched.\n'
  prompt "Type DISCARD INCOMPLETE $PROJECT exactly" ''
  [ "$ANSWER" = "DISCARD INCOMPLETE $PROJECT" ] || fail 'Incomplete-restore discard canceled; nothing was deleted.'
  compose down >/dev/null 2>&1 || fail 'Could not stop incomplete restoration resources.'
  volume=${PROJECT}_postgres-data
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    owned
    [ -z "$(docker ps -aq --filter "volume=$volume")" ] || fail 'Incomplete database volume has consumers; refused deletion.'
    docker volume rm "$volume" >/dev/null || fail 'Could not remove incomplete database volume.'
  fi
  [ ! -L "$STATE" ] && [ "$STATE" != / ] || fail 'Unsafe incomplete state path.'
  rm -rf -- "$STATE"
