  [ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT")" ] || fail 'Restore project containers already exist.'
  [ -z "$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT")" ] || fail 'Restore project volume already exists.'
  docker volume inspect "${PROJECT}_postgres-data" >/dev/null 2>&1 && fail 'Restore project volume name already exists.'
  compose config --quiet >/dev/null 2>&1 || fail 'Restored Compose configuration is invalid.'
  postgres_image
  docker run --rm --network none --user "$(id -u):$(id -g)" -v "$RESTORE_STAGE/database.dump:/bundle/database.dump:ro" postgres:17-alpine pg_restore --list /bundle/database.dump >/dev/null 2>&1 || fail 'Bundle PostgreSQL dump is unreadable; target state remains absent.'
  build_images
  bundle_tool promote "$STATE" "$TARGET_STATE"
  STATE=$TARGET_STATE
  compose_env
  compose up -d --wait --wait-timeout 180 --no-build --pull never postgres >/dev/null 2>&1 || fail 'PostgreSQL restore target failed to initialize; partial state is retained for inspection.'
  owned
  compose exec -T postgres pg_restore -U kelios -d kelios --no-owner --no-privileges --exit-on-error --single-transaction < "$RESTORE_STAGE/database.dump" >/dev/null 2>&1 || fail 'Database import failed; partial restoration is retained and cannot start.'
  flyway_history > "$WORK/flyway" || fail 'Cannot verify restored Flyway history; restoration remains incomplete.'
  bundle_tool flyway-equal "$RESTORE_STAGE/manifest.json" "$WORK/flyway"
