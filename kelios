  OLD_HTTP_PORT=$HTTP_PORT; OLD_HTTPS_PORT=$HTTPS_PORT
  NEW_LOGO=; NEW_ORG_LOGO=; CLEAR_LOGO=false; CLEAR_ORG_LOGO=false
  if [ "$NONINTERACTIVE" = 1 ]; then
    [ -n "$INPUT_CONFIG" ] && [ -n "${CONFIG_KEYS-}" ] || fail 'Noninteractive config requires a nonempty --config file.'
    for field in $CONFIG_KEYS; do case "$field" in BIND|HTTP_PORT|HTTPS_PORT|THEME|ORGANIZATION_LOGO) ;; *) fail "Unsupported config update field: $field";; esac; done
    case "$CONFIG_SEEN" in *'|BIND|'*) BIND=$C_BIND;; esac
    case "$CONFIG_SEEN" in *'|HTTP_PORT|'*) HTTP_PORT=$C_HTTP_PORT;; esac
