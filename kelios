      7) prompt 'Organization logo path (empty clears)' ''; if [ -n "$ANSWER" ]; then [ -f "$ANSWER" ] || fail 'Organization logo unavailable.'; NEW_ORG_LOGO=$ANSWER; else CLEAR_ORG_LOGO=true; NEW_ORG_LOGO=; fi;;
      8) save_configuration; return;;
      0) printf 'No configuration changes saved.\n'; return;; *) printf 'Select a listed option.\n';;
    esac
  done
}
uninstall() {
  terminal; compose_env; owned
  prompt "Remove runtime for $PROJECT, preserving database/configuration/keys? yes/no" 'no'
  [ "$ANSWER" = yes ] || { printf 'Canceled.\n'; return; }
  compose down >/dev/null 2>&1 || fail 'Runtime removal failed; persistent state preserved.'
