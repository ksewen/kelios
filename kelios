    [ "$(docker inspect --format '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$id")" = running/healthy ] || fail 'Backup needs a healthy managed runtime.'
    if [ "$service" != postgres ]; then
      [ "$(docker inspect --format '{{.Config.Image}}' "$id")" = "kelios-$service:$RELEASE" ] || fail 'Running application image differs from the saved release; finish or recover the update before backup.'
    fi
  done
  flyway_history > "$WORK/flyway" || fail 'Cannot read successful Flyway history; backup refused.'
  [ -s "$WORK/flyway" ] || fail 'Flyway history is empty; backup refused.'
  compose exec -T postgres pg_dump -U kelios -d kelios -Fc > "$WORK/database.dump" 2>/dev/null || fail 'Managed PostgreSQL dump failed; no bundle was published.'
  [ -s "$WORK/database.dump" ] || fail 'Managed PostgreSQL dump is empty; no bundle was published.'
  compose exec -T postgres pg_restore --list < "$WORK/database.dump" >/dev/null 2>&1 || fail 'Managed PostgreSQL dump is unreadable; no bundle was published.'
  bundle_tool pack "$STATE" "$WORK/database.dump" "$WORK/flyway" "$BACKUP_OUTPUT" "$ROOT"
  printf 'Private managed recovery bundle ready: %s\n' "$BACKUP_OUTPUT"
}
restore() {
