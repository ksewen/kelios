}
status() {
  if [ ! -e "$STATE" ]; then printf 'KELIOS\n\nStatus: not initialized\n'; return; fi
  if [ ! -f "$STATE/installation.conf" ] && [ -f "$STATE/certificate.conf" ]; then certificate_load; printf 'KELIOS\n\nStatus: certificate provisioned for %s; installation pending\n' "$CERT_HOST"; return; fi
  load; compose_env; owned
  SUMMARY=running; ROWS=
  SERVICES='backend frontend'; [ "$MODE" != managed ] || SERVICES="$SERVICES postgres"
  for service in $SERVICES; do
    id=$(compose ps --all --quiet "$service")
    if [ -z "$id" ]; then info=absent; else info=$(docker inspect --format '{{.State.Status}} ({{if .State.Health}}{{.State.Health.Status}}{{else}}no health signal{{end}})' "$id"); fi
    [ "$info" = 'running (healthy)' ] || SUMMARY=stopped-or-degraded
    ROWS="$ROWS$service: $info
"
  done
  [ "$PHASE" != prepared ] || SUMMARY=installation-pending
  [ "$PHASE" != restoring ] || SUMMARY=restoration-incomplete
  printf 'KELIOS\n\nStatus: %s\nRelease: %s\n\n%s\nURL: https://%s:%s\nDatabase: %s PostgreSQL\n' "$SUMMARY" "$RELEASE" "$ROWS" "$BROWSER_HOST" "$HTTPS_PORT" "$MODE"
  [ "$PHASE" != prepared ] || printf 'Installation incomplete: run resume-install from the recorded clean source release.\n'
  [ "$PHASE" != restoring ] || printf 'Restore incomplete: inspect the failure; use restore discard-incomplete only after confirming this target is disposable.\n'
  [ "$PHASE" != data-deleted ] || printf 'Managed database permanently deleted.\n'
}
logs() {
  if [ ! -f "$STATE/installation.conf" ]; then printf 'No installation logs at %s.\n' "$STATE"; return; fi
  load; compose_env; owned
  compose logs --no-color --tail 100 > "$WORK/logs-output" 2>&1 || fail 'Cannot read KELIOS container logs; inspect Docker access and deployment identity.'
  sed -E 's#(/api/v1/auth/[^?[:space:]]*)\?[^[:space:]]*#\1?[REDACTED]#g' "$WORK/logs-output"
  rm -f "$WORK/logs-output"
}
save_configuration() {
  validate
  [ "$HTTP_PORT" = "$OLD_HTTP_PORT" ] || port_free "$HTTP_PORT"
  [ "$HTTPS_PORT" = "$OLD_HTTPS_PORT" ] || port_free "$HTTPS_PORT"
  if [ "$CLEAR_LOGO" = true ]; then LOGO=; elif [ -n "$NEW_LOGO" ]; then logo_copy "$NEW_LOGO" legacy; fi
  if [ "$CLEAR_ORG_LOGO" = true ]; then ORG_LOGO=; elif [ -n "$NEW_ORG_LOGO" ]; then logo_copy "$NEW_ORG_LOGO" organization; fi
