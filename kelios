flyway_history() {
  compose exec -T postgres psql -X -v ON_ERROR_STOP=1 -U kelios -d kelios -Atc "SELECT coalesce(version,'')||'|'||coalesce(checksum::text,'')||'|'||CASE WHEN success THEN 't' ELSE 'f' END FROM flyway_schema_history ORDER BY installed_rank" 2>/dev/null
}
bundle_tool() {
  command -v python3 >/dev/null 2>&1 || fail 'Python 3 is required for managed backup and restore.'
