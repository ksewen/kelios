  cp "$1" "$LOGO_TEMP"; chmod 444 "$LOGO_TEMP"; mv -f "$LOGO_TEMP" "$STATE/branding/logos/$filename"
}
theme() {
  case "$1" in orange) BACKGROUND='#f7f7f5'; FOREGROUND='#18181b'; PRIMARY='#cd3a06'; PRIMARY_FOREGROUND='#ffffff'; ACCENT='#fff0eb'; ACCENT_FOREGROUND='#8f2904';;
    green) BACKGROUND='#f2faf5'; FOREGROUND='#16372b'; PRIMARY='#087f5b'; PRIMARY_FOREGROUND='#ffffff'; ACCENT='#d8f2e4'; ACCENT_FOREGROUND='#14543c';;
    blue) BACKGROUND='#f4f7ff'; FOREGROUND='#172033'; PRIMARY='#2458d3'; PRIMARY_FOREGROUND='#ffffff'; ACCENT='#e1eaff'; ACCENT_FOREGROUND='#243b75';; *) fail 'Select orange, blue or green.';; esac
