    docker volume inspect "${PROJECT}_postgres-data" >/dev/null 2>&1 || fail 'Initialized managed database volume is missing; refused to create an empty replacement.'
  fi
  compose config --quiet >/dev/null 2>&1 || fail 'Deployment configuration invalid.'
  for image in $(compose config --images); do
    docker image inspect "$image" >/dev/null 2>&1 || fail 'A required image is missing. Build/pull the maintained deployment images explicitly before start.'
  done
  if [ "${1-}" = restart ]; then set -- --force-recreate; else set --; fi
  compose up -d --wait --wait-timeout 180 --no-build --pull never "$@" >/dev/null 2>&1 || fail 'Runtime failed to become healthy. Check Docker, ports, database access and migrations; run start to retry. Configuration and data were preserved. Database migrations may already have committed.'
}
source_release() {
  command -v git >/dev/null 2>&1 || fail 'Git is required to identify a source release.'
  changes=$(git -C "$ROOT" status --porcelain --untracked-files=normal 2>/dev/null) || fail 'Source must be a readable Git checkout.'
  [ -z "$changes" ] || fail 'Source checkout has uncommitted files; use a clean checkout for install or update.'
  commit=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null) || fail 'Source must be a Git checkout with a commit.'
  RELEASE=$(printf '%s' "$commit" | cut -c 1-12)
  case "$RELEASE" in *[!0-9a-f]*|'') fail 'Git returned an invalid release identity.';; esac
  [ "${#RELEASE}" = 12 ] || fail 'Git returned an invalid release identity.'
}
build_images() {
  compose config --quiet >/dev/null 2>&1 || fail 'Deployment configuration invalid; build not started.'
  printf 'Building independent application images for release %s.\n' "$RELEASE"
  compose build > "$STATE/diagnostics/build-output" 2>&1 || fail 'Image build failed; private build-output is retained for local inspection. Runtime and data were preserved.'
  rm -f "$STATE/diagnostics/build-output"
}
postgres_image() {
  docker image inspect postgres:17-alpine >/dev/null 2>&1 && return
