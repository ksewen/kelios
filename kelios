  chmod 755 "$STATE/secrets/auth" "$STATE/secrets/tls" "$STATE/branding" "$STATE/branding/logos"
  if [ "$MODE" = external ] && [ "$NONINTERACTIVE" = 1 ]; then cp "$C_DB_PASSWORD_FILE" "$STATE/secrets/db-password"; else printf '%s' "$DB_PASSWORD" > "$STATE/secrets/db-password"; unset DB_PASSWORD; fi
