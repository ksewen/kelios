#!/bin/sh
# Deployment orchestration only. Application policy remains in the backend.
set -eu
set +x
# Remove inherited export attributes before assigning any private input.
unset PASSWORD FIRST DB_PASSWORD encoded
umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
STATE=${XDG_DATA_HOME:-$HOME/.local/share}/kelios/default
INPUT_CONFIG=
NONINTERACTIVE=0
CONFIRM_REPLACE=0
BACKUP_OUTPUT=
RESTORE_BUNDLE=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --state-dir|--config|--output|--bundle)
      [ "$#" -ge 2 ] || { printf 'Missing value for %s\n' "$1" >&2; exit 1; }
      case "$1" in --state-dir) STATE=$2;; --config) INPUT_CONFIG=$2;; --output) BACKUP_OUTPUT=$2;; --bundle) RESTORE_BUNDLE=$2;; esac
      shift 2;;
    --non-interactive) NONINTERACTIVE=1; shift;;
    --confirm-replace) CONFIRM_REPLACE=1; shift;;
    *) break;;
  esac
done
while [ "${STATE%/}" != "$STATE" ]; do STATE=${STATE%/}; done
case "$STATE" in /*) ;; *) printf 'State directory must be absolute.\n' >&2; exit 1;; esac
case "$STATE" in /|*/./*|*/../*|*/.|*/..) printf 'State directory must identify one installation directory without dot segments.\n' >&2; exit 1;; esac
case "$STATE" in *[\'\"\$\`\\]*) printf 'State directory contains unsupported characters.\n' >&2; exit 1;; esac
NEWLINE='
'
CR=$(printf '\r')
case "$STATE" in *"$NEWLINE"*|*"$CR"*|*:*) printf 'State directory contains unsupported characters.\n' >&2; exit 1;; esac
LOCK=$STATE.lock
LOCKED=0
ECHO_OFF=0
TEMP=
ENV_FILE=
WORK=
STAGED_CERT=
RESTORE_STAGE=
fail() { printf 'KELIOS: %s\n' "$*" >&2; exit 1; }
cleanup() {
  if [ "$ECHO_OFF" = 1 ]; then stty echo </dev/tty 2>/dev/null || :; fi
  if [ -n "$WORK" ] && [ -d "$WORK" ]; then
    rm -f "$WORK/compose.env" "$WORK/logs-output" "$WORK/recovery/password" "$WORK/recovery/output" "$WORK/certificate.pem" "$WORK/private.pem" "$WORK/database.dump" "$WORK/flyway"
    rmdir "$WORK/recovery" 2>/dev/null || :
    rmdir "$WORK" 2>/dev/null || :
  fi
  if [ -n "$STAGED_CERT" ] && [ -d "$STAGED_CERT" ]; then rm -f "$STAGED_CERT/certificate.pem" "$STAGED_CERT/private.pem"; rmdir "$STAGED_CERT" 2>/dev/null || :; fi
  if [ -n "$RESTORE_STAGE" ] && [ -d "$RESTORE_STAGE" ] && [ ! -L "$RESTORE_STAGE" ]; then rm -rf -- "$RESTORE_STAGE"; fi
  if [ "$LOCKED" = 1 ]; then rmdir "$LOCK" 2>/dev/null || :; fi
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP
usage() { printf 'Usage: ./kelios [--state-dir ABSOLUTE_PATH] [--config FILE] [--output NEW_ABSOLUTE_DIRECTORY] [--bundle ABSOLUTE_DIRECTORY] [--non-interactive] [--confirm-replace] {doctor|install|resume-install|update|start|stop|restart|status|logs|config|uninstall|recover-admin|backup|restore|restore discard-incomplete|certificate init|certificate replace|host prepare docker-access}\n'; }
case "$*" in 'certificate init'|'certificate replace'|'host prepare docker-access'|'restore discard-incomplete') COMMAND=$*;; *) [ "$#" = 1 ] || { usage; exit 1; }; COMMAND=$1;; esac
case "$COMMAND" in doctor|install|resume-install|update|start|stop|restart|status|logs|config|uninstall|recover-admin|backup|restore|'restore discard-incomplete'|'certificate init'|'certificate replace'|'host prepare docker-access') ;; *) usage; exit 1;; esac
[ "$CONFIRM_REPLACE" = 0 ] || [ "$COMMAND" = 'certificate replace' ] || fail '--confirm-replace is only valid for certificate replace.'
[ -z "$BACKUP_OUTPUT" ] || [ "$COMMAND" = backup ] || fail '--output is only valid for backup.'
[ -z "$RESTORE_BUNDLE" ] || [ "$COMMAND" = restore ] || fail '--bundle is only valid for restore.'
case "$ROOT" in *[\'\"\$\`\\]* ) fail 'Repository path contains unsupported quoting characters.';; esac
[ ! -L "$STATE" ] || fail 'Installation directory must not be a symlink.'
workspace() {
  [ -n "$WORK" ] && return
  local_tmp=${TMPDIR:-/tmp}
  case "$local_tmp" in /*) ;; *) fail 'Temporary directory must be absolute.';; esac
  case "$local_tmp" in *"$NEWLINE"*|*"$CR"*|*:*) fail 'Temporary directory contains unsupported characters.';; esac
  [ -d "$local_tmp" ] || fail 'Temporary directory is unavailable.'
  WORK=$(mktemp -d "$local_tmp/kelios.XXXXXXXX") || fail 'Cannot create private temporary workspace.'
}
read_config() {
  [ -z "$INPUT_CONFIG" ] && return
  [ -f "$INPUT_CONFIG" ] && [ ! -L "$INPUT_CONFIG" ] || fail 'Input configuration file is unavailable or unsafe.'
  CONFIG_SEEN='|'
  while IFS='=' read -r key value || [ -n "$key" ]; do
    [ -n "$key" ] || continue
    case "$CONFIG_SEEN" in *"|$key|"*) fail 'Duplicate input configuration field.';; esac
    CONFIG_SEEN=$CONFIG_SEEN$key'|'
    case "$key" in
      BIND) C_BIND=$value;; HTTP_PORT) C_HTTP_PORT=$value;; HTTPS_PORT) C_HTTPS_PORT=$value;; BROWSER_HOST) C_BROWSER_HOST=$value;;
      TLS_CERTIFICATE) C_TLS_CERTIFICATE=$value;; TLS_PRIVATE_KEY) C_TLS_PRIVATE_KEY=$value;;
      MODE) C_MODE=$value;; DB_HOST) C_DB_HOST=$value;; DB_PORT) C_DB_PORT=$value;; DB_NAME) C_DB_NAME=$value;; DB_USER) C_DB_USER=$value;;
      DB_PASSWORD_FILE) C_DB_PASSWORD_FILE=$value;; THEME) C_THEME=$value;; ORGANIZATION_LOGO) C_ORGANIZATION_LOGO=$value;; AUTH_KEYS_DIRECTORY) C_AUTH_KEYS_DIRECTORY=$value;;
      ADMIN_EMAIL) C_ADMIN_EMAIL=$value;; ADMIN_DISPLAY_NAME) C_ADMIN_DISPLAY_NAME=$value;; ADMIN_PASSWORD_FILE) C_ADMIN_PASSWORD_FILE=$value;;
      *) fail "Unknown input configuration field: $key";;
    esac
    CONFIG_KEYS="${CONFIG_KEYS-} $key"
  done < "$INPUT_CONFIG"
}
validate_input_config() {
  [ -z "${C_BIND-}" ] || bind "$C_BIND"
  [ -z "${C_HTTP_PORT-}" ] || port "$C_HTTP_PORT"
  [ -z "${C_HTTPS_PORT-}" ] || port "$C_HTTPS_PORT"
  [ -z "${C_BROWSER_HOST-}" ] || host "$C_BROWSER_HOST"
  [ -z "${C_DB_HOST-}" ] || host "$C_DB_HOST"
  [ -z "${C_DB_PORT-}" ] || port "$C_DB_PORT"
  [ -z "${C_DB_NAME-}" ] || identifier "$C_DB_NAME"
  [ -z "${C_DB_USER-}" ] || identifier "$C_DB_USER"
  case "${C_MODE-}" in ''|managed|external) ;; *) fail 'Database mode must be managed or external.';; esac
  case "${C_THEME-}" in ''|orange|green|blue) ;; *) fail 'Theme must be orange, green or blue.';; esac
}
docker_endpoint() {
  [ -z "${DOCKER_HOST-}" ] || [ -z "${DOCKER_CONTEXT-}" ] || fail 'DOCKER_HOST and DOCKER_CONTEXT are both set; select one unambiguous local Docker endpoint.'
  if [ -n "${DOCKER_CONTEXT-}" ]; then endpoint=$(docker context inspect "$DOCKER_CONTEXT" --format '{{.Endpoints.docker.Host}}' 2>/dev/null) || fail 'Cannot inspect the selected Docker context.'
  elif [ -n "${DOCKER_HOST-}" ]; then endpoint=$DOCKER_HOST
  else endpoint=$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null) || fail 'Cannot inspect the selected Docker context.'; fi
  case "$endpoint" in unix:///*) ;; *) fail 'A local Unix-socket Docker context is required because KELIOS bind-mounts local instance files. Select a local Docker context.';; esac
}
docker_access() {
  [ "$(id -u)" != 0 ] || fail 'Run KELIOS as the ordinary operator user so persistent state is not root-owned.'
  case "$(uname -s)" in Linux|Darwin) ;; *) fail 'Unsupported host OS. Use a tested Linux server or macOS development host.';; esac
  case "$(uname -m)" in x86_64|aarch64|arm64) ;; *) fail 'Unsupported CPU architecture. Use AMD64 or ARM64.';; esac
  command -v docker >/dev/null 2>&1 || fail 'Docker Engine is absent. Install Docker Engine before deploying KELIOS.'
  docker compose version >/dev/null 2>&1 || fail 'Docker Compose plugin is absent or unusable. Install a supported Compose plugin (v2 or later).'
  docker_endpoint
  if docker_error=$(docker info 2>&1 >/dev/null); then :; else
    case "$docker_error" in *'permission denied'*|*'Permission denied'*) fail 'Docker socket access denied. Authorized Docker access grants high-privilege host control; on supported Linux hosts inspect ./kelios host prepare docker-access.';; esac
    fail 'Docker daemon is unavailable. Start the installed Docker daemon and check its context/socket.'
  fi
  docker_security=$(docker info --format '{{json .SecurityOptions}}' 2>/dev/null) || fail 'Cannot inspect Docker security options.'
  case "$docker_security" in *rootless*) fail 'Rootless Docker is outside the supported deployment contract.';; esac
}
prerequisites() {
  docker_access
  command -v openssl >/dev/null 2>&1 || fail 'OpenSSL is required for key generation and validation.'
}
port_free() {
  if [ "$(uname -s)" = Linux ]; then
    command -v ss >/dev/null 2>&1 || fail 'Linux port preflight needs ss (iproute2). Install it before deploying KELIOS.'
    listeners=$(ss -H -ltn) || fail 'Cannot inspect listening TCP ports with ss.'
    if printf '%s\n' "$listeners" | awk -v port="$1" '$4 ~ ":" port "$" {busy=1} END {exit !busy}'; then fail "Host port $1 is already listening. Choose another port or stop the conflicting service."; fi
  else
    command -v lsof >/dev/null 2>&1 || fail 'macOS port preflight needs lsof.'
    if lsof -nP "-iTCP:$1" -sTCP:LISTEN >/dev/null 2>&1; then fail "Host port $1 is already listening. Choose another port or stop the conflicting service."; fi
  fi
}
doctor() {
  validate_input_config
  docker_access
  command -v openssl >/dev/null 2>&1 || fail 'OpenSSL is absent. Install OpenSSL before deploying KELIOS.'
  if [ -f "$STATE/installation.conf" ]; then load; files; compose_env; owned; compose config --quiet >/dev/null 2>&1 || fail 'Saved deployment configuration does not render with Compose.'; printf 'KELIOS doctor: prerequisites, saved files and deployment identity valid.\n'; elif [ -f "$STATE/certificate.conf" ]; then certificate_load; BROWSER_HOST=$CERT_HOST; tls "$CERT_DIR/certificate.pem" "$CERT_DIR/private.pem"; port_free "${C_HTTP_PORT:-8080}"; port_free "${C_HTTPS_PORT:-8443}"; printf 'KELIOS doctor: certificate provisioned; installation pending.\n'; else port_free "${C_HTTP_PORT:-8080}"; port_free "${C_HTTPS_PORT:-8443}"; printf 'KELIOS doctor: basic prerequisites and requested ports available; no installation at %s.\n' "$STATE"; fi
}
host_prepare_docker_access() {
  [ "$(uname -s)" = Linux ] || fail 'Docker-access preparation is supported only on Linux hosts.'
  [ "$(id -u)" != 0 ] || fail 'Run host preparation as the ordinary operator user, not root.'
  command -v docker >/dev/null 2>&1 || fail 'Install Docker Engine before preparing access.'
  docker_endpoint
  [ "$endpoint" = unix:///var/run/docker.sock ] || fail 'Automated access preparation supports only the local /var/run/docker.sock context.'
  if docker_error=$(docker info 2>&1 >/dev/null); then printf 'Docker access already works; no host change made.\n'; return; fi
  case "$docker_error" in *'permission denied'*|*'Permission denied'*) ;; *) fail 'Docker daemon is unavailable for a reason other than socket permission. Start or repair Docker before changing group membership.';; esac
  [ -S /var/run/docker.sock ] || fail 'Docker socket is absent. Start Docker Engine before changing access.'
  socket_group=$(stat -c %G /var/run/docker.sock) || fail 'Cannot inspect Docker socket group.'
  [ "$socket_group" = docker ] || fail 'Docker socket is not owned by the docker group; inspect host policy instead of changing membership.'
  socket_mode=$(stat -c %A /var/run/docker.sock) || fail 'Cannot inspect Docker socket permissions.'
  case "$socket_mode" in ?????w????) ;; *) fail 'Docker socket is not group-writable; changing group membership would not grant access.';; esac
  case " $(id -nG) " in *' docker '*) fail 'This session already has docker group membership; inspect the socket ACL/context. No host change made.';; esac
  operator_name=$(id -un)
  account_groups=$(id -nG "$operator_name") || fail 'Cannot inspect the operator account groups.'
  case " $account_groups " in *' docker '*) fail 'The account already belongs to the docker group. Log out and back in instead of changing host membership.';; esac
  command -v sudo >/dev/null 2>&1 || fail 'sudo is required for the optional group change. Ask the host administrator to grant approved Docker access.'
  [ "$NONINTERACTIVE" = 0 ] || fail 'Host access preparation requires an interactive terminal and explicit confirmation.'
  terminal
  case "$operator_name" in ''|-*|*[!A-Za-z0-9_.-]*) fail 'Unsupported operator account name for automatic group preparation.';; esac
  printf 'Docker group membership grants high-privilege control of this host.\nProposed command: sudo usermod -aG docker -- %s\n' "$operator_name"
  prompt 'Type GRANT DOCKER ACCESS exactly to apply this host change' ''
  [ "$ANSWER" = 'GRANT DOCKER ACCESS' ] || fail 'Docker access preparation canceled; no host change made.'
  sudo usermod -aG docker -- "$operator_name" || fail 'Docker group change failed; inspect sudo policy and host logs.'
  printf 'Docker group membership requested. Log out and back in, then run ./kelios doctor.\n'
}
lock() {
  [ ! -L "$LOCK" ] || fail 'Unsafe installation lock.'
  case "$COMMAND" in install|'certificate init'|restore) mkdir -p "$(dirname "$STATE")" || fail 'Cannot create state parent.';; esac
  mkdir "$LOCK" 2>/dev/null || fail 'Another operation or an abandoned .kelios.lock exists. Inspect before removing the lock.'
  LOCKED=1
}
terminal() { [ -t 0 ] && [ -t 1 ] || fail 'This command requires an interactive terminal.'; }
prompt() {
  configured=
  case "$1" in
    'Listen address') configured=${C_BIND-};; 'HTTP technical/health port') configured=${C_HTTP_PORT-};; 'HTTPS application port') configured=${C_HTTPS_PORT-};;
    'Browser hostname (certificate must cover it)') configured=${C_BROWSER_HOST-};; 'TLS certificate path (required)') configured=${C_TLS_CERTIFICATE-};; 'TLS private-key path (required)') configured=${C_TLS_PRIVATE_KEY-};;
    'Database mode: managed or external') configured=${C_MODE-};; 'Database host (container localhost is not the host machine)') configured=${C_DB_HOST-};; 'Database port') configured=${C_DB_PORT-};; 'Database name') configured=${C_DB_NAME-};; 'Database username') configured=${C_DB_USER-};;
    'Runtime theme: orange, blue or green') configured=${C_THEME-};; 'Organization logo path (empty for neutral mark)') configured=${C_ORGANIZATION_LOGO-};; 'Existing authentication key directory (empty for a new database)') configured=${C_AUTH_KEYS_DIRECTORY-};;
    'GLOBAL ADMIN Email') configured=${C_ADMIN_EMAIL-};; 'Display name') configured=${C_ADMIN_DISPLAY_NAME-};;
  esac
  if [ -n "$configured" ]; then ANSWER=$configured; return; fi
  if [ "$NONINTERACTIVE" = 1 ]; then
    case "$1" in 'Organization logo path (empty for neutral mark)'|'Existing authentication key directory (empty for a new database)') ANSWER=; return;; esac
    [ -n "$2" ] || fail "Missing required input: $1"
    ANSWER=$2; return
  fi
  printf '%s [%s]: ' "$1" "$2"
  IFS= read -r ANSWER || fail 'Input interrupted.'
  [ -n "$ANSWER" ] || ANSWER=$2
}
password() {
  stty -echo </dev/tty; ECHO_OFF=1
  printf '%s: ' "$1"
  IFS= read -r PASSWORD || fail 'Input interrupted.'
  stty echo </dev/tty; ECHO_OFF=0; printf '\n'
  [ -n "$PASSWORD" ] || fail 'Password cannot be empty.'
}
port() { case "$1" in ''|*[!0-9]*|0*) fail 'Port must be an integer from 1 to 65535, without leading zeros.';; esac; [ "${#1}" -le 5 ] && [ "$1" -le 65535 ] || fail 'Invalid port.'; }
identifier() { case "$1" in ''|*[!A-Za-z0-9_.-]*) fail 'Use letters, digits, dot, underscore or hyphen.';; esac; [ "${#1}" -le 64 ] || fail 'Identifier too long.'; }
host() { case "$1" in ''|*[!A-Za-z0-9.:-]*|-*|.*) fail 'Invalid host.';; esac; [ "${#1}" -le 253 ] || fail 'Host too long.'; }
bind() {
  case "$1" in *:*) printf '%s\n' "$1" | LC_ALL=C awk '
      /[^0-9a-fA-F:]/ || /:::/ {exit 1}
      {n=split($0,halves,"::"); if(n>2) exit 1; count=0;
       for(h=1;h<=n;h++) {if(halves[h]=="") continue; m=split(halves[h],groups,":");
         for(i=1;i<=m;i++) if(groups[i]!~/^[0-9a-fA-F]+$/ || length(groups[i])>4) exit 1; count+=m}
       if((n==1 && count!=8) || (n==2 && count>=8)) exit 1}' || fail 'Invalid IPv6 bind address.';;
    *) printf '%s\n' "$1" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/ || length($i)>3 || $i>255) exit 1}' || fail 'Invalid IPv4 bind address.';; esac
}
validate() {
  [ "$SCHEMA" = 1 ] || fail 'Unsupported installation schema.'
  case "$PROJECT" in kelios-local-*) ;; *) fail 'Invalid installation identity.';; esac
  identifier "$PROJECT"
  case "$MODE" in managed|external) ;; *) fail 'Invalid database mode.';; esac
  case "$PHASE" in prepared|initialized|data-deleted|restoring) ;; *) fail 'Invalid installation state.';; esac
  case "$RELEASE" in phase0) ;; *) case "$RELEASE" in *[!0-9a-f]*|'') fail 'Invalid release identity.';; esac; [ "${#RELEASE}" = 12 ] || fail 'Invalid release identity.';; esac
  bind "$BIND"; port "$HTTP_PORT"; port "$HTTPS_PORT"
  [ "$HTTP_PORT" != "$HTTPS_PORT" ] || fail 'HTTP and HTTPS ports must differ.'
  host "$BROWSER_HOST"; host "$DB_HOST"; port "$DB_PORT"; identifier "$DB_NAME"; identifier "$DB_USER"
  case "$BROWSER_HOST" in *:*) fail 'Use a DNS name or IPv4 address for the browser host (IPv6 bind is supported).';; esac
  case "$ISSUER" in https://*) ;; *) fail 'Invalid JWT issuer.';; esac
  case "$ISSUER" in *[!A-Za-z0-9.:/-]*) fail 'Invalid JWT issuer.';; esac
  for color in "$BACKGROUND" "$FOREGROUND" "$PRIMARY" "$PRIMARY_FOREGROUND" "$ACCENT" "$ACCENT_FOREGROUND"; do
    printf '%s\n' "$color" | LC_ALL=C awk '!/^#[0-9a-fA-F]{6}$/ {exit 1}' || fail 'Theme colors must be six-digit hexadecimal values.'
  done
  case "$LOGO" in ''|logo.svg|logo.png|logo.jpg|logo.webp) ;; *) fail 'Invalid logo state.';; esac
  case "$ORG_LOGO" in ''|organization.svg|organization.png|organization.jpg|organization.webp) ;; *) fail 'Invalid organization logo state.';; esac
}
load() {
  [ -f "$STATE/installation.conf" ] && [ ! -L "$STATE/installation.conf" ] || fail 'Installation is not initialized. Run ./kelios install.'
  [ -z "$(find "$STATE" -type l -print)" ] || fail 'Installation state contains unsafe symlinks.'
  SEEN='|'; ORG_LOGO=; RELEASE=phase0
  while IFS='=' read -r key value; do
    case "$SEEN" in *"|$key|"*) fail 'Duplicate installation field.';; esac
    SEEN=$SEEN$key'|'
    case "$key" in
      SCHEMA) SCHEMA=$value;; PROJECT) PROJECT=$value;; MODE) MODE=$value;; PHASE) PHASE=$value;; RELEASE) RELEASE=$value;;
      BIND) BIND=$value;; HTTP_PORT) HTTP_PORT=$value;; HTTPS_PORT) HTTPS_PORT=$value;; BROWSER_HOST) BROWSER_HOST=$value;; ISSUER) ISSUER=$value;;
      DB_HOST) DB_HOST=$value;; DB_PORT) DB_PORT=$value;; DB_NAME) DB_NAME=$value;; DB_USER) DB_USER=$value;;
      BACKGROUND) BACKGROUND=$value;; FOREGROUND) FOREGROUND=$value;; PRIMARY) PRIMARY=$value;; PRIMARY_FOREGROUND) PRIMARY_FOREGROUND=$value;;
      ACCENT) ACCENT=$value;; ACCENT_FOREGROUND) ACCENT_FOREGROUND=$value;; LOGO) LOGO=$value;; ORG_LOGO) ORG_LOGO=$value;; *) fail 'Unknown installation field.';;
    esac
  done < "$STATE/installation.conf"
  case "$SEEN" in '|SCHEMA|PROJECT|MODE|PHASE|BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|ISSUER|DB_HOST|DB_PORT|DB_NAME|DB_USER|BACKGROUND|FOREGROUND|PRIMARY|PRIMARY_FOREGROUND|ACCENT|ACCENT_FOREGROUND|LOGO|'|'|SCHEMA|PROJECT|MODE|PHASE|BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|ISSUER|DB_HOST|DB_PORT|DB_NAME|DB_USER|BACKGROUND|FOREGROUND|PRIMARY|PRIMARY_FOREGROUND|ACCENT|ACCENT_FOREGROUND|LOGO|ORG_LOGO|'|'|SCHEMA|PROJECT|MODE|PHASE|RELEASE|BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|ISSUER|DB_HOST|DB_PORT|DB_NAME|DB_USER|BACKGROUND|FOREGROUND|PRIMARY|PRIMARY_FOREGROUND|ACCENT|ACCENT_FOREGROUND|LOGO|ORG_LOGO|') ;; *) fail 'Incomplete or reordered installation configuration.';; esac
  validate
}
save() {
  validate
  MANIFEST_TEMP=$(mktemp "$STATE/installation.XXXXXXXX")
  { for field in SCHEMA PROJECT MODE PHASE RELEASE BIND HTTP_PORT HTTPS_PORT BROWSER_HOST ISSUER DB_HOST DB_PORT DB_NAME DB_USER BACKGROUND FOREGROUND PRIMARY PRIMARY_FOREGROUND ACCENT ACCENT_FOREGROUND LOGO ORG_LOGO; do
      # Explicit cases: no eval and never execute saved data.
      case "$field" in SCHEMA) v=$SCHEMA;; PROJECT) v=$PROJECT;; MODE) v=$MODE;; PHASE) v=$PHASE;; RELEASE) v=$RELEASE;; BIND) v=$BIND;; HTTP_PORT) v=$HTTP_PORT;; HTTPS_PORT) v=$HTTPS_PORT;; BROWSER_HOST) v=$BROWSER_HOST;; ISSUER) v=$ISSUER;; DB_HOST) v=$DB_HOST;; DB_PORT) v=$DB_PORT;; DB_NAME) v=$DB_NAME;; DB_USER) v=$DB_USER;; BACKGROUND) v=$BACKGROUND;; FOREGROUND) v=$FOREGROUND;; PRIMARY) v=$PRIMARY;; PRIMARY_FOREGROUND) v=$PRIMARY_FOREGROUND;; ACCENT) v=$ACCENT;; ACCENT_FOREGROUND) v=$ACCENT_FOREGROUND;; LOGO) v=$LOGO;; ORG_LOGO) v=$ORG_LOGO;; esac
      printf '%s=%s\n' "$field" "$v"
    done; } > "$MANIFEST_TEMP"
  mv -f "$MANIFEST_TEMP" "$STATE/installation.conf"
}
branding() {
  BRANDING_TEMP=$(mktemp "$STATE/branding/config.XXXXXXXX")
  { printf '{"schemaVersion":1';
    [ -z "$LOGO" ] || printf ',"logoUrl":"/runtime/logos/%s"' "$LOGO"
    [ -z "$ORG_LOGO" ] || printf ',"organizationLogoUrl":"/runtime/logos/%s"' "$ORG_LOGO"
    printf ',"theme":{"background":"%s","foreground":"%s","primary":"%s","primaryForeground":"%s","accent":"%s","accentForeground":"%s"}}\n' "$BACKGROUND" "$FOREGROUND" "$PRIMARY" "$PRIMARY_FOREGROUND" "$ACCENT" "$ACCENT_FOREGROUND"
  } > "$BRANDING_TEMP"
  chmod 444 "$BRANDING_TEMP"
  mv -f "$BRANDING_TEMP" "$STATE/branding/config.json"
}
compose_env() {
  certificate_load
  [ "$CERT_HOST" = "$BROWSER_HOST" ] || fail 'Certificate identity differs from the installation browser host.'
  case "$BIND" in *:*) PUBLISH_BIND=[$BIND];; *) PUBLISH_BIND=$BIND;; esac
  case "$DB_HOST" in *:*) JDBC_HOST=[$DB_HOST];; *) JDBC_HOST=$DB_HOST;; esac
  workspace
  ENV_FILE=$WORK/compose.env
  { printf 'KELIOS_BIND_ADDRESS=%s\nKELIOS_HTTP_PORT=%s\nKELIOS_HTTPS_PORT=%s\n' "$PUBLISH_BIND" "$HTTP_PORT" "$HTTPS_PORT"
    printf 'KELIOS_BACKEND_IMAGE=kelios-backend:%s\nKELIOS_FRONTEND_IMAGE=kelios-frontend:%s\n' "$RELEASE" "$RELEASE"
    printf 'KELIOS_DATABASE_URL=jdbc:postgresql://%s:%s/%s\nKELIOS_DATABASE_USER=%s\n' "$JDBC_HOST" "$DB_PORT" "$DB_NAME" "$DB_USER"
    printf "KELIOS_DB_PASSWORD_FILE='%s/secrets/db-password'\nKELIOS_AUTH_KEY_DIRECTORY='%s/secrets/auth'\nKELIOS_TLS_DIRECTORY='%s'\nKELIOS_BRANDING_DIRECTORY='%s/branding'\nKELIOS_LOGO_DIRECTORY='%s/branding/logos'\n" "$STATE" "$STATE" "$CERT_DIR" "$STATE" "$STATE"
    printf 'KELIOS_AUTH_PUBLIC_ORIGIN=https://%s:%s\nKELIOS_AUTH_ISSUER=%s\n' "$BROWSER_HOST" "$HTTPS_PORT" "$ISSUER"
  } > "$ENV_FILE"
  # Ambient shell deployment settings must not override recorded installation.
  unset COMPOSE_PROFILES COMPOSE_PROJECT_NAME COMPOSE_FILE KELIOS_BACKEND_IMAGE KELIOS_FRONTEND_IMAGE KELIOS_BIND_ADDRESS KELIOS_HTTP_PORT KELIOS_HTTPS_PORT KELIOS_DATABASE_URL KELIOS_DATABASE_USER KELIOS_DATABASE_PASSWORD KELIOS_DB_PASSWORD_FILE KELIOS_AUTH_KEY_DIRECTORY KELIOS_TLS_DIRECTORY KELIOS_BRANDING_DIRECTORY KELIOS_LOGO_DIRECTORY KELIOS_AUTH_PUBLIC_ORIGIN KELIOS_AUTH_ISSUER KELIOS_AUTH_SIGNING_KEY_ID KELIOS_AUTH_ENCRYPTION_KEY_ID KELIOS_AUTH_TRUSTED_PROVIDER_HOSTS KELIOS_AUTH_PROVIDER_TRUST_STORE KELIOS_AUTH_PROVIDER_TRUST_STORE_PASSWORD
}
compose() {
  if [ "$MODE" = managed ]; then
    docker compose --env-file "$ENV_FILE" -p "$PROJECT" -f "$ROOT/deploy/compose.yaml" -f "$ROOT/deploy/compose.postgres.yaml" -f "$ROOT/deploy/compose.auth.yaml" "$@"
