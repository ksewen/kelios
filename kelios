    case "$CONFIG_SEEN" in *'|THEME|'*) theme "$C_THEME";; esac
    case "$CONFIG_SEEN" in *'|ORGANIZATION_LOGO|'*) if [ -n "$C_ORGANIZATION_LOGO" ]; then NEW_ORG_LOGO=$C_ORGANIZATION_LOGO; else CLEAR_ORG_LOGO=true; fi;; esac
