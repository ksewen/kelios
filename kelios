    external)
      printf 'Use a dedicated KELIOS database reachable from containers. Flyway will migrate it. External data is never deleted.\n'
      prompt 'Database host (container localhost is not the host machine)' ''; DB_HOST=$ANSWER; host "$DB_HOST"
      prompt 'Database port' '5432'; DB_PORT=$ANSWER; port "$DB_PORT"
      prompt 'Database name' 'kelios'; DB_NAME=$ANSWER; identifier "$DB_NAME"
      prompt 'Database username' 'kelios'; DB_USER=$ANSWER; identifier "$DB_USER"
      if [ "$NONINTERACTIVE" = 1 ]; then
        [ -n "${C_DB_PASSWORD_FILE-}" ] && [ -f "$C_DB_PASSWORD_FILE" ] && [ ! -L "$C_DB_PASSWORD_FILE" ] || fail 'DB_PASSWORD_FILE must name a readable regular file.'
      else password 'Database password'; DB_PASSWORD=$PASSWORD; unset PASSWORD; fi;; *) fail 'Select managed or external.';; esac
  prompt 'Runtime theme: orange, blue or green' 'orange'; BRAND=$ANSWER; theme "$BRAND"
  prompt 'Organization logo path (empty for neutral mark)' ''; ORG_LOGO_SOURCE=$ANSWER
  [ -z "$ORG_LOGO_SOURCE" ] || [ -f "$ORG_LOGO_SOURCE" ] || fail 'Organization logo is unavailable.'
  prompt 'Existing authentication key directory (empty for a new database)' ''; SUPPLIED_KEYS=$ANSWER
  if [ -n "$SUPPLIED_KEYS" ]; then
    for f in main.private.pem main.public.pem main.aes; do [ -f "$SUPPLIED_KEYS/$f" ] || fail 'Supplied key directory incomplete.'; done
  fi
