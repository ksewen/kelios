#!/bin/sh
# Deployment orchestration only. Application policy remains in the backend.
set -eu
set +x
# Remove inherited export attributes before assigning any private input.
unset PASSWORD FIRST DB_PASSWORD encoded
umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
STATE=${XDG_DATA_HOME:-$HOME/.local/share}/kelios/default
INPUT_CONFIG=
NONINTERACTIVE=0
CONFIRM_REPLACE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --state-dir|--config) [ "$#" -ge 2 ] || { printf 'Missing value for %s\n' "$1" >&2; exit 1; }; if [ "$1" = --state-dir ]; then STATE=$2; else INPUT_CONFIG=$2; fi; shift 2;;
    --non-interactive) NONINTERACTIVE=1; shift;;
    --confirm-replace) CONFIRM_REPLACE=1; shift;;
    *) break;;
  esac
done
while [ "${STATE%/}" != "$STATE" ]; do STATE=${STATE%/}; done
case "$STATE" in /*) ;; *) printf 'State directory must be absolute.\n' >&2; exit 1;; esac
case "$STATE" in /|*/./*|*/../*|*/.|*/..) printf 'State directory must identify one installation directory without dot segments.\n' >&2; exit 1;; esac
case "$STATE" in *[\'\"\$\`\\]*) printf 'State directory contains unsupported characters.\n' >&2; exit 1;; esac
NEWLINE='
'
CR=$(printf '\r')
case "$STATE" in *"$NEWLINE"*|*"$CR"*|*:*) printf 'State directory contains unsupported characters.\n' >&2; exit 1;; esac
LOCK=$STATE.lock
LOCKED=0
ECHO_OFF=0
TEMP=
ENV_FILE=
WORK=
STAGED_CERT=
fail() { printf 'KELIOS: %s\n' "$*" >&2; exit 1; }
cleanup() {
  if [ "$ECHO_OFF" = 1 ]; then stty echo </dev/tty 2>/dev/null || :; fi
  if [ -n "$WORK" ] && [ -d "$WORK" ]; then
    rm -f "$WORK/compose.env" "$WORK/recovery/password" "$WORK/recovery/output" "$WORK/certificate.pem" "$WORK/private.pem"
    rmdir "$WORK/recovery" 2>/dev/null || :
    rmdir "$WORK" 2>/dev/null || :
  fi
  if [ -n "$STAGED_CERT" ] && [ -d "$STAGED_CERT" ]; then rm -f "$STAGED_CERT/certificate.pem" "$STAGED_CERT/private.pem"; rmdir "$STAGED_CERT" 2>/dev/null || :; fi
  if [ "$LOCKED" = 1 ]; then rmdir "$LOCK" 2>/dev/null || :; fi
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP
usage() { printf 'Usage: ./kelios [--state-dir ABSOLUTE_PATH] [--config FILE] [--non-interactive] [--confirm-replace] {doctor|install|start|stop|status|config|uninstall|recover-admin|certificate init|certificate replace}\n'; }
case "$*" in 'certificate init'|'certificate replace') COMMAND=$*;; *) [ "$#" = 1 ] || { usage; exit 1; }; COMMAND=$1;; esac
case "$COMMAND" in doctor|install|start|stop|status|config|uninstall|recover-admin|'certificate init'|'certificate replace') ;; *) usage; exit 1;; esac
[ "$CONFIRM_REPLACE" = 0 ] || [ "$COMMAND" = 'certificate replace' ] || fail '--confirm-replace is only valid for certificate replace.'
case "$ROOT" in *[\'\"\$\`\\]* ) fail 'Repository path contains unsupported quoting characters.';; esac
[ ! -L "$STATE" ] || fail 'Installation directory must not be a symlink.'
workspace() {
  [ -n "$WORK" ] && return
  local_tmp=${TMPDIR:-/tmp}
  case "$local_tmp" in /*) ;; *) fail 'Temporary directory must be absolute.';; esac
  case "$local_tmp" in *"$NEWLINE"*|*"$CR"*|*:*) fail 'Temporary directory contains unsupported characters.';; esac
  [ -d "$local_tmp" ] || fail 'Temporary directory is unavailable.'
  WORK=$(mktemp -d "$local_tmp/kelios.XXXXXXXX") || fail 'Cannot create private temporary workspace.'
}
read_config() {
  [ -z "$INPUT_CONFIG" ] && return
  [ -f "$INPUT_CONFIG" ] && [ ! -L "$INPUT_CONFIG" ] || fail 'Input configuration file is unavailable or unsafe.'
  CONFIG_SEEN='|'
  while IFS='=' read -r key value || [ -n "$key" ]; do
    [ -n "$key" ] || continue
    case "$CONFIG_SEEN" in *"|$key|"*) fail 'Duplicate input configuration field.';; esac
    CONFIG_SEEN=$CONFIG_SEEN$key'|'
    case "$key" in
      BIND) C_BIND=$value;; HTTP_PORT) C_HTTP_PORT=$value;; HTTPS_PORT) C_HTTPS_PORT=$value;; BROWSER_HOST) C_BROWSER_HOST=$value;;
      TLS_CERTIFICATE) C_TLS_CERTIFICATE=$value;; TLS_PRIVATE_KEY) C_TLS_PRIVATE_KEY=$value;;
      MODE) C_MODE=$value;; DB_HOST) C_DB_HOST=$value;; DB_PORT) C_DB_PORT=$value;; DB_NAME) C_DB_NAME=$value;; DB_USER) C_DB_USER=$value;;
      DB_PASSWORD_FILE) C_DB_PASSWORD_FILE=$value;; THEME) C_THEME=$value;; ORGANIZATION_LOGO) C_ORGANIZATION_LOGO=$value;; AUTH_KEYS_DIRECTORY) C_AUTH_KEYS_DIRECTORY=$value;;
      ADMIN_EMAIL) C_ADMIN_EMAIL=$value;; ADMIN_DISPLAY_NAME) C_ADMIN_DISPLAY_NAME=$value;; ADMIN_PASSWORD_FILE) C_ADMIN_PASSWORD_FILE=$value;;
      *) fail "Unknown input configuration field: $key";;
    esac
  done < "$INPUT_CONFIG"
}
validate_input_config() {
  [ -z "${C_BIND-}" ] || bind "$C_BIND"
  [ -z "${C_HTTP_PORT-}" ] || port "$C_HTTP_PORT"
  [ -z "${C_HTTPS_PORT-}" ] || port "$C_HTTPS_PORT"
  [ -z "${C_BROWSER_HOST-}" ] || host "$C_BROWSER_HOST"
  [ -z "${C_DB_HOST-}" ] || host "$C_DB_HOST"
  [ -z "${C_DB_PORT-}" ] || port "$C_DB_PORT"
  [ -z "${C_DB_NAME-}" ] || identifier "$C_DB_NAME"
  [ -z "${C_DB_USER-}" ] || identifier "$C_DB_USER"
  case "${C_MODE-}" in ''|managed|external) ;; *) fail 'Database mode must be managed or external.';; esac
  case "${C_THEME-}" in ''|orange|green|blue) ;; *) fail 'Theme must be orange, green or blue.';; esac
}
prerequisites() {
  command -v docker >/dev/null 2>&1 || fail 'Install Docker with Docker Compose first.'
  docker info >/dev/null 2>&1 || fail 'Docker daemon is unavailable.'
  docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required.'
  command -v openssl >/dev/null 2>&1 || fail 'OpenSSL is required for key generation and validation.'
}
doctor() {
  validate_input_config
  case "$(uname -s)" in Linux|Darwin) ;; *) fail 'Unsupported host OS. Use a tested Linux server or macOS development host.';; esac
  case "$(uname -m)" in x86_64|aarch64|arm64) ;; *) fail 'Unsupported CPU architecture. Use AMD64 or ARM64.';; esac
  command -v docker >/dev/null 2>&1 || fail 'Docker Engine is absent. Install Docker Engine before deploying KELIOS.'
  docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is absent. Install the Compose plugin.'
  if ! docker info >/dev/null 2>&1; then
    if [ -S /var/run/docker.sock ] && [ ! -w /var/run/docker.sock ]; then
      fail 'Docker socket access denied. The operator account needs authorized Docker access; this grants high-privilege host control.'
    fi
    fail 'Docker daemon is unavailable. Start the installed Docker daemon and check its context.'
  fi
  command -v openssl >/dev/null 2>&1 || fail 'OpenSSL is absent. Install OpenSSL before deploying KELIOS.'
  if [ -f "$STATE/installation.conf" ]; then load; files; printf 'KELIOS doctor: basic prerequisites and saved files present.\n'; elif [ -f "$STATE/certificate.conf" ]; then certificate_load; BROWSER_HOST=$CERT_HOST; tls "$CERT_DIR/certificate.pem" "$CERT_DIR/private.pem"; printf 'KELIOS doctor: certificate provisioned; installation pending.\n'; else printf 'KELIOS doctor: basic prerequisites available; no installation at %s.\n' "$STATE"; fi
}
lock() {
  [ ! -L "$LOCK" ] || fail 'Unsafe installation lock.'
  case "$COMMAND" in install|'certificate init') mkdir -p "$(dirname "$STATE")" || fail 'Cannot create state parent.';; esac
  mkdir "$LOCK" 2>/dev/null || fail 'Another operation or an abandoned .kelios.lock exists. Inspect before removing the lock.'
  LOCKED=1
}
terminal() { [ -t 0 ] && [ -t 1 ] || fail 'This command requires an interactive terminal.'; }
prompt() {
  configured=
  case "$1" in
    'Listen address') configured=${C_BIND-};; 'HTTP technical/health port') configured=${C_HTTP_PORT-};; 'HTTPS application port') configured=${C_HTTPS_PORT-};;
    'Browser hostname (certificate must cover it)') configured=${C_BROWSER_HOST-};; 'TLS certificate path (required)') configured=${C_TLS_CERTIFICATE-};; 'TLS private-key path (required)') configured=${C_TLS_PRIVATE_KEY-};;
    'Database mode: managed or external') configured=${C_MODE-};; 'Database host (container localhost is not the host machine)') configured=${C_DB_HOST-};; 'Database port') configured=${C_DB_PORT-};; 'Database name') configured=${C_DB_NAME-};; 'Database username') configured=${C_DB_USER-};;
    'Runtime theme: orange, blue or green') configured=${C_THEME-};; 'Organization logo path (empty for neutral mark)') configured=${C_ORGANIZATION_LOGO-};; 'Existing authentication key directory (empty for a new database)') configured=${C_AUTH_KEYS_DIRECTORY-};;
    'GLOBAL ADMIN Email') configured=${C_ADMIN_EMAIL-};; 'Display name') configured=${C_ADMIN_DISPLAY_NAME-};;
  esac
  if [ -n "$configured" ]; then ANSWER=$configured; return; fi
  if [ "$NONINTERACTIVE" = 1 ]; then
    case "$1" in 'Organization logo path (empty for neutral mark)'|'Existing authentication key directory (empty for a new database)') ANSWER=; return;; esac
    [ -n "$2" ] || fail "Missing required input: $1"
    ANSWER=$2; return
  fi
  printf '%s [%s]: ' "$1" "$2"
  IFS= read -r ANSWER || fail 'Input interrupted.'
  [ -n "$ANSWER" ] || ANSWER=$2
}
password() {
  stty -echo </dev/tty; ECHO_OFF=1
  printf '%s: ' "$1"
  IFS= read -r PASSWORD || fail 'Input interrupted.'
  stty echo </dev/tty; ECHO_OFF=0; printf '\n'
  [ -n "$PASSWORD" ] || fail 'Password cannot be empty.'
}
port() { case "$1" in ''|*[!0-9]*|0*) fail 'Port must be an integer from 1 to 65535, without leading zeros.';; esac; [ "${#1}" -le 5 ] && [ "$1" -le 65535 ] || fail 'Invalid port.'; }
identifier() { case "$1" in ''|*[!A-Za-z0-9_.-]*) fail 'Use letters, digits, dot, underscore or hyphen.';; esac; [ "${#1}" -le 64 ] || fail 'Identifier too long.'; }
host() { case "$1" in ''|*[!A-Za-z0-9.:-]*|-*|.*) fail 'Invalid host.';; esac; [ "${#1}" -le 253 ] || fail 'Host too long.'; }
bind() {
  case "$1" in *:*) printf '%s\n' "$1" | LC_ALL=C awk '
      /[^0-9a-fA-F:]/ || /:::/ {exit 1}
      {n=split($0,halves,"::"); if(n>2) exit 1; count=0;
       for(h=1;h<=n;h++) {if(halves[h]=="") continue; m=split(halves[h],groups,":");
         for(i=1;i<=m;i++) if(groups[i]!~/^[0-9a-fA-F]+$/ || length(groups[i])>4) exit 1; count+=m}
       if((n==1 && count!=8) || (n==2 && count>=8)) exit 1}' || fail 'Invalid IPv6 bind address.';;
    *) printf '%s\n' "$1" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/ || length($i)>3 || $i>255) exit 1}' || fail 'Invalid IPv4 bind address.';; esac
}
validate() {
  [ "$SCHEMA" = 1 ] || fail 'Unsupported installation schema.'
  case "$PROJECT" in kelios-local-*) ;; *) fail 'Invalid installation identity.';; esac
  identifier "$PROJECT"
  case "$MODE" in managed|external) ;; *) fail 'Invalid database mode.';; esac
  case "$PHASE" in prepared|initialized|data-deleted) ;; *) fail 'Invalid installation state.';; esac
  bind "$BIND"; port "$HTTP_PORT"; port "$HTTPS_PORT"
  [ "$HTTP_PORT" != "$HTTPS_PORT" ] || fail 'HTTP and HTTPS ports must differ.'
  host "$BROWSER_HOST"; host "$DB_HOST"; port "$DB_PORT"; identifier "$DB_NAME"; identifier "$DB_USER"
  case "$BROWSER_HOST" in *:*) fail 'Use a DNS name or IPv4 address for the browser host (IPv6 bind is supported).';; esac
  case "$ISSUER" in https://*) ;; *) fail 'Invalid JWT issuer.';; esac
  case "$ISSUER" in *[!A-Za-z0-9.:/-]*) fail 'Invalid JWT issuer.';; esac
  for color in "$BACKGROUND" "$FOREGROUND" "$PRIMARY" "$PRIMARY_FOREGROUND" "$ACCENT" "$ACCENT_FOREGROUND"; do
    printf '%s\n' "$color" | LC_ALL=C awk '!/^#[0-9a-fA-F]{6}$/ {exit 1}' || fail 'Theme colors must be six-digit hexadecimal values.'
  done
  case "$LOGO" in ''|logo.svg|logo.png|logo.jpg|logo.webp) ;; *) fail 'Invalid logo state.';; esac
  case "$ORG_LOGO" in ''|organization.svg|organization.png|organization.jpg|organization.webp) ;; *) fail 'Invalid organization logo state.';; esac
}
load() {
  [ -f "$STATE/installation.conf" ] && [ ! -L "$STATE/installation.conf" ] || fail 'Installation is not initialized. Run ./kelios install.'
  [ -z "$(find "$STATE" -type l -print)" ] || fail 'Installation state contains unsafe symlinks.'
  SEEN='|'; ORG_LOGO=
  while IFS='=' read -r key value; do
    case "$SEEN" in *"|$key|"*) fail 'Duplicate installation field.';; esac
    SEEN=$SEEN$key'|'
    case "$key" in
      SCHEMA) SCHEMA=$value;; PROJECT) PROJECT=$value;; MODE) MODE=$value;; PHASE) PHASE=$value;;
      BIND) BIND=$value;; HTTP_PORT) HTTP_PORT=$value;; HTTPS_PORT) HTTPS_PORT=$value;; BROWSER_HOST) BROWSER_HOST=$value;; ISSUER) ISSUER=$value;;
      DB_HOST) DB_HOST=$value;; DB_PORT) DB_PORT=$value;; DB_NAME) DB_NAME=$value;; DB_USER) DB_USER=$value;;
      BACKGROUND) BACKGROUND=$value;; FOREGROUND) FOREGROUND=$value;; PRIMARY) PRIMARY=$value;; PRIMARY_FOREGROUND) PRIMARY_FOREGROUND=$value;;
      ACCENT) ACCENT=$value;; ACCENT_FOREGROUND) ACCENT_FOREGROUND=$value;; LOGO) LOGO=$value;; ORG_LOGO) ORG_LOGO=$value;; *) fail 'Unknown installation field.';;
    esac
  done < "$STATE/installation.conf"
  case "$SEEN" in '|SCHEMA|PROJECT|MODE|PHASE|BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|ISSUER|DB_HOST|DB_PORT|DB_NAME|DB_USER|BACKGROUND|FOREGROUND|PRIMARY|PRIMARY_FOREGROUND|ACCENT|ACCENT_FOREGROUND|LOGO|'|'|SCHEMA|PROJECT|MODE|PHASE|BIND|HTTP_PORT|HTTPS_PORT|BROWSER_HOST|ISSUER|DB_HOST|DB_PORT|DB_NAME|DB_USER|BACKGROUND|FOREGROUND|PRIMARY|PRIMARY_FOREGROUND|ACCENT|ACCENT_FOREGROUND|LOGO|ORG_LOGO|') ;; *) fail 'Incomplete or reordered installation configuration.';; esac
  validate
}
save() {
  validate
  MANIFEST_TEMP=$(mktemp "$STATE/installation.XXXXXXXX")
  { for field in SCHEMA PROJECT MODE PHASE BIND HTTP_PORT HTTPS_PORT BROWSER_HOST ISSUER DB_HOST DB_PORT DB_NAME DB_USER BACKGROUND FOREGROUND PRIMARY PRIMARY_FOREGROUND ACCENT ACCENT_FOREGROUND LOGO ORG_LOGO; do
      # Explicit cases: no eval and never execute saved data.
      case "$field" in SCHEMA) v=$SCHEMA;; PROJECT) v=$PROJECT;; MODE) v=$MODE;; PHASE) v=$PHASE;; BIND) v=$BIND;; HTTP_PORT) v=$HTTP_PORT;; HTTPS_PORT) v=$HTTPS_PORT;; BROWSER_HOST) v=$BROWSER_HOST;; ISSUER) v=$ISSUER;; DB_HOST) v=$DB_HOST;; DB_PORT) v=$DB_PORT;; DB_NAME) v=$DB_NAME;; DB_USER) v=$DB_USER;; BACKGROUND) v=$BACKGROUND;; FOREGROUND) v=$FOREGROUND;; PRIMARY) v=$PRIMARY;; PRIMARY_FOREGROUND) v=$PRIMARY_FOREGROUND;; ACCENT) v=$ACCENT;; ACCENT_FOREGROUND) v=$ACCENT_FOREGROUND;; LOGO) v=$LOGO;; ORG_LOGO) v=$ORG_LOGO;; esac
      printf '%s=%s\n' "$field" "$v"
    done; } > "$MANIFEST_TEMP"
  mv -f "$MANIFEST_TEMP" "$STATE/installation.conf"
}
branding() {
  BRANDING_TEMP=$(mktemp "$STATE/branding/config.XXXXXXXX")
  { printf '{"schemaVersion":1';
    [ -z "$LOGO" ] || printf ',"logoUrl":"/runtime/logos/%s"' "$LOGO"
    [ -z "$ORG_LOGO" ] || printf ',"organizationLogoUrl":"/runtime/logos/%s"' "$ORG_LOGO"
    printf ',"theme":{"background":"%s","foreground":"%s","primary":"%s","primaryForeground":"%s","accent":"%s","accentForeground":"%s"}}\n' "$BACKGROUND" "$FOREGROUND" "$PRIMARY" "$PRIMARY_FOREGROUND" "$ACCENT" "$ACCENT_FOREGROUND"
  } > "$BRANDING_TEMP"
  chmod 444 "$BRANDING_TEMP"
  mv -f "$BRANDING_TEMP" "$STATE/branding/config.json"
}
compose_env() {
  certificate_load
  [ "$CERT_HOST" = "$BROWSER_HOST" ] || fail 'Certificate identity differs from the installation browser host.'
  case "$BIND" in *:*) PUBLISH_BIND=[$BIND];; *) PUBLISH_BIND=$BIND;; esac
  case "$DB_HOST" in *:*) JDBC_HOST=[$DB_HOST];; *) JDBC_HOST=$DB_HOST;; esac
  workspace
  ENV_FILE=$WORK/compose.env
  { printf 'KELIOS_BIND_ADDRESS=%s\nKELIOS_HTTP_PORT=%s\nKELIOS_HTTPS_PORT=%s\n' "$PUBLISH_BIND" "$HTTP_PORT" "$HTTPS_PORT"
    printf 'KELIOS_DATABASE_URL=jdbc:postgresql://%s:%s/%s\nKELIOS_DATABASE_USER=%s\n' "$JDBC_HOST" "$DB_PORT" "$DB_NAME" "$DB_USER"
    printf "KELIOS_DB_PASSWORD_FILE='%s/secrets/db-password'\nKELIOS_AUTH_KEY_DIRECTORY='%s/secrets/auth'\nKELIOS_TLS_DIRECTORY='%s'\nKELIOS_BRANDING_DIRECTORY='%s/branding'\nKELIOS_LOGO_DIRECTORY='%s/branding/logos'\n" "$STATE" "$STATE" "$CERT_DIR" "$STATE" "$STATE"
    printf 'KELIOS_AUTH_PUBLIC_ORIGIN=https://%s:%s\nKELIOS_AUTH_ISSUER=%s\n' "$BROWSER_HOST" "$HTTPS_PORT" "$ISSUER"
  } > "$ENV_FILE"
  # Ambient shell deployment settings must not override recorded installation.
  unset COMPOSE_PROFILES COMPOSE_PROJECT_NAME COMPOSE_FILE KELIOS_BIND_ADDRESS KELIOS_HTTP_PORT KELIOS_HTTPS_PORT KELIOS_DATABASE_URL KELIOS_DATABASE_USER KELIOS_DATABASE_PASSWORD KELIOS_DB_PASSWORD_FILE KELIOS_AUTH_KEY_DIRECTORY KELIOS_TLS_DIRECTORY KELIOS_BRANDING_DIRECTORY KELIOS_LOGO_DIRECTORY KELIOS_AUTH_PUBLIC_ORIGIN KELIOS_AUTH_ISSUER KELIOS_AUTH_SIGNING_KEY_ID KELIOS_AUTH_ENCRYPTION_KEY_ID KELIOS_AUTH_TRUSTED_PROVIDER_HOSTS KELIOS_AUTH_PROVIDER_TRUST_STORE KELIOS_AUTH_PROVIDER_TRUST_STORE_PASSWORD
}
compose() {
  if [ "$MODE" = managed ]; then
    docker compose --env-file "$ENV_FILE" -p "$PROJECT" -f "$ROOT/deploy/compose.yaml" -f "$ROOT/deploy/compose.postgres.yaml" -f "$ROOT/deploy/compose.auth.yaml" "$@"
  else
    docker compose --env-file "$ENV_FILE" -p "$PROJECT" -f "$ROOT/deploy/compose.yaml" -f "$ROOT/deploy/compose.auth.yaml" "$@"
  fi
}
owned() {
  if [ "$MODE" = managed ] && docker volume inspect "${PROJECT}_postgres-data" >/dev/null 2>&1; then
    volume_owner=$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "${PROJECT}_postgres-data")
    volume_kind=$(docker volume inspect --format '{{index .Labels "com.docker.compose.volume"}}' "${PROJECT}_postgres-data")
    [ "$volume_owner" = "$PROJECT" ] && [ "$volume_kind" = postgres-data ] || fail 'Managed volume ownership mismatch.'
  fi
  # Inspect only IDs bearing the exact recorded project label. Never broad prune.
  for id in $(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT"); do
    label=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$id")
    [ "$label" = "$PROJECT" ] || fail 'Container ownership mismatch.'
    service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$id")
    case "$service" in backend|frontend|postgres) ;; *) fail 'Project identity belongs to another deployment.';; esac
  done
}
files() {
  certificate_load
  [ "$CERT_HOST" = "$BROWSER_HOST" ] || fail 'Certificate identity differs from the installation browser host.'
  for f in installation.conf secrets/db-password secrets/auth/main.private.pem secrets/auth/main.public.pem secrets/auth/main.aes branding/config.json; do
    [ -f "$STATE/$f" ] && [ ! -L "$STATE/$f" ] || fail "Required installation file missing or unsafe: $f"
  done
  for f in "$LOGO" "$ORG_LOGO"; do [ -z "$f" ] || { [ -f "$STATE/branding/logos/$f" ] && [ ! -L "$STATE/branding/logos/$f" ]; } || fail 'Required logo file missing or unsafe.'; done
  for dir in secrets secrets/auth secrets/tls branding branding/logos; do [ -d "$STATE/$dir" ] && [ ! -L "$STATE/$dir" ] || fail "Unsafe directory: $dir"; done
}
crypto() {
  openssl pkey -in "$STATE/secrets/auth/main.private.pem" -passin pass: -check -noout >/dev/null 2>&1 || fail 'Signing private key unavailable/invalid.'
  a=$(openssl pkey -in "$STATE/secrets/auth/main.private.pem" -pubout 2>/dev/null | openssl dgst -sha256)
  b=$(openssl pkey -pubin -in "$STATE/secrets/auth/main.public.pem" -pubout 2>/dev/null | openssl dgst -sha256)
  [ "$a" = "$b" ] || fail 'Signing key pair mismatch.'
  bits=$(openssl pkey -pubin -in "$STATE/secrets/auth/main.public.pem" -text -noout 2>/dev/null | head -1)
  case "$bits" in *3072*|*4096*|*6144*|*8192*) ;; *) fail 'Supply an RSA key of at least 3072 bits (supported sizes: 3072/4096/6144/8192).';; esac
  for aes_file in "$STATE/secrets/auth/"*.aes; do
    encoded=$(cat "$aes_file")
    printf '%s\n' "$encoded" | LC_ALL=C awk '$0 !~ /^[A-Za-z0-9+\/]{43}=$/ {exit 1}' || fail 'AES keys must be single-line base64-encoded 32 bytes.'
    bytes=$(openssl base64 -d -A < "$aes_file" | wc -c | tr -d ' ')
    [ "$bytes" = 32 ] || fail 'AES key must be base64-encoded 32 bytes.'
    unset encoded
  done
  tls "$CERT_DIR/certificate.pem" "$CERT_DIR/private.pem"
}
tls() {
  [ -f "$1" ] && [ -f "$2" ] || fail 'Supply readable TLS certificate and private-key files, or run certificate init before installation.'
  openssl x509 -in "$1" -checkend 0 -noout >/dev/null 2>&1 || fail 'TLS certificate invalid or expired.'
  openssl pkey -in "$2" -passin pass: -check -noout >/dev/null 2>&1 || fail 'TLS key must be readable, valid and unencrypted for nginx.'
  a=$(openssl x509 -in "$1" -pubkey -noout 2>/dev/null | openssl dgst -sha256)
  b=$(openssl pkey -in "$2" -passin pass: -pubout 2>/dev/null | openssl dgst -sha256)
  [ "$a" = "$b" ] || fail 'TLS certificate/private-key mismatch.'
  case "$BROWSER_HOST" in *[!0-9.]* ) check=-checkhost;; *) check=-checkip;; esac
  openssl x509 -in "$1" "$check" "$BROWSER_HOST" -noout >/dev/null 2>&1 || fail 'TLS certificate does not cover the browser host.'
}
certificate_load() {
  [ -f "$STATE/certificate.conf" ] && [ ! -L "$STATE/certificate.conf" ] || fail 'Certificate state missing; provision a certificate before installation.'
  [ -z "$(find "$STATE" -type l -print)" ] || fail 'Certificate state contains unsafe symlinks.'
  IFS= read -r cert_host_line < "$STATE/certificate.conf" || fail 'Invalid certificate state.'
  cert_version_line=$(sed -n '2p' "$STATE/certificate.conf")
  [ "$(wc -l < "$STATE/certificate.conf" | tr -d ' ')" = 2 ] || fail 'Invalid certificate state.'
  case "$cert_host_line" in HOST=*) CERT_HOST=${cert_host_line#HOST=};; *) fail 'Invalid certificate identity.';; esac
  host "$CERT_HOST"
  case "$CERT_HOST" in *:*) fail 'Certificate identity must be a DNS name or IPv4 address.';; esac
  case "$cert_version_line" in VERSION=*) CERT_VERSION=${cert_version_line#VERSION=};; *) fail 'Invalid certificate version.';; esac
  case "$CERT_VERSION" in ''|*[!0-9a-f]*) fail 'Invalid certificate version.';; esac
  [ "${#CERT_VERSION}" = 12 ] || fail 'Invalid certificate version.'
  CERT_DIR=$STATE/secrets/tls/$CERT_VERSION
  [ -d "$CERT_DIR" ] && [ ! -L "$CERT_DIR" ] || fail 'Active certificate directory missing or unsafe.'
  for f in certificate.pem private.pem; do [ -f "$CERT_DIR/$f" ] && [ ! -L "$CERT_DIR/$f" ] || fail 'Active certificate file missing or unsafe.'; done
}
certificate_store() {
  [ -d "$STATE/secrets/tls" ] || mkdir -p "$STATE/secrets/tls"
  chmod 755 "$STATE/secrets/tls"
  STAGED_CERT=$(mktemp -d "$STATE/secrets/tls/.pending.XXXXXXXX") || fail 'Cannot stage certificate.'
