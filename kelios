      [ -f "$supplied" ] || fail 'Supplied authentication directory must contain key files only.'
      filename=${supplied##*/}
      case "$filename" in *.private.pem) key_id=${filename%.private.pem};; *.public.pem) key_id=${filename%.public.pem};; *.aes) key_id=${filename%.aes};; *) fail 'Unsupported file in supplied authentication key directory.';; esac
