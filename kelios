  [ "$BROWSER_HOST" != localhost ] || san=$san,IP:127.0.0.1
  openssl req -x509 -newkey rsa:3072 -nodes -keyout "$WORK/private.pem" -out "$WORK/certificate.pem" -days 730 -subj "/CN=$BROWSER_HOST" -addext "subjectAltName=$san" >/dev/null 2>&1 || fail 'Private certificate generation failed; check OpenSSL support.'
  certificate_store "$WORK/certificate.pem" "$WORK/private.pem"
  rm -f "$WORK/private.pem" "$WORK/certificate.pem"
}
certificate_command() {
  if [ "$COMMAND" = 'certificate init' ]; then
    [ ! -e "$STATE" ] || fail 'Certificate or installation state already exists; nothing was overwritten.'
    prompt 'Browser hostname (certificate must cover it)' 'localhost'; BROWSER_HOST=$ANSWER
    host "$BROWSER_HOST"
    case "$BROWSER_HOST" in *:*) fail 'Use a DNS name or IPv4 address for the certificate.';; esac
    mkdir "$STATE"; chmod 700 "$STATE"
    certificate_generate
    printf 'Private certificate provisioned for %s (730 days). Trust it explicitly on intended clients; run ./kelios install.\n' "$BROWSER_HOST"
  else
    certificate_load
    BROWSER_HOST=$CERT_HOST
    if [ -f "$STATE/installation.conf" ]; then load; [ "$BROWSER_HOST" = "$CERT_HOST" ] || fail 'Certificate identity differs from the installation browser host.'; fi
    [ -z "${C_BROWSER_HOST-}" ] || [ "$C_BROWSER_HOST" = "$BROWSER_HOST" ] || fail 'Replacement cannot change the persisted browser host.'
    if [ "$NONINTERACTIVE" = 1 ]; then [ "$CONFIRM_REPLACE" = 1 ] || fail 'Use --confirm-replace for noninteractive certificate replacement.'
    else terminal; prompt "Type REPLACE $BROWSER_HOST exactly to replace the certificate (self-signed unless PEM paths are configured)" ''; [ "$ANSWER" = "REPLACE $BROWSER_HOST" ] || fail 'Certificate replacement canceled.'; fi
    if [ -n "${C_TLS_CERTIFICATE-}${C_TLS_PRIVATE_KEY-}" ]; then
      [ -n "${C_TLS_CERTIFICATE-}" ] && [ -n "${C_TLS_PRIVATE_KEY-}" ] || fail 'Provide both TLS_CERTIFICATE and TLS_PRIVATE_KEY.'
      certificate_store "$C_TLS_CERTIFICATE" "$C_TLS_PRIVATE_KEY"
    else certificate_generate; fi
    printf 'Certificate replaced for %s. Previous version retained. Run ./kelios start to apply to the runtime; clients may need to trust the new certificate.\n' "$BROWSER_HOST"
  fi
